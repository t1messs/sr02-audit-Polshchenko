<Project>
  <!--
    Вимірювання цикломатичної складності інструментом CA1502 без зміни коду проєкту.
    Запуск із кореня репозиторію:
      dotnet build src -p:DirectoryBuildPropsPath=$PWD/tools/metrics.props --no-incremental
    Поріг 1 у CodeMetricsConfig.txt змушує CA1502 повідомити складність кожного методу, де CC >= 2.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)CodeMetricsConfig.txt" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)metrics.globalconfig" />
  </ItemGroup>
</Project>
